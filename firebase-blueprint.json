{
  "entities": {
    "products": {
      "title": "Produtos",
      "description": "Lista de produtos e serviços do pet shop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "subgroup": { "type": "string" },
        "unitType": { "type": "string" },
        "backgroundColor": { "type": "string" }
      },
      "required": ["id", "code", "name", "price", "stock", "category"]
    },
    "sales": {
      "title": "Vendas",
      "description": "Registro de vendas realizadas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "total": { "type": "number" },
        "change": { "type": "number" },
        "timestamp": { "type": "number" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "isCreditSale": { "type": "boolean" },
        "items": { "type": "array" },
        "payments": { "type": "array" }
      },
      "required": ["id", "total", "timestamp", "items"]
    },
    "customers": {
      "title": "Clientes",
      "description": "Cadastro de clientes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "petName": { "type": "string" },
        "petBreed": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "paymentMethods": {
      "title": "Métodos de Pagamento",
      "description": "Configurações de formas de pagamento",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "feePercent": { "type": "number" }
      },
      "required": ["id", "name", "icon"]
    },
    "settings": {
      "title": "Configurações",
      "description": "Configurações globais do sistema",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyAddress": { "type": "string" },
        "companyPhone": { "type": "string" },
        "companyLogo": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "products",
      "description": "Coleção de produtos"
    },
    "/sales/{saleId}": {
      "schema": "sales",
      "description": "Coleção de vendas"
    },
    "/customers/{customerId}": {
      "schema": "customers",
      "description": "Coleção de clientes"
    },
    "/paymentMethods/{methodId}": {
      "schema": "paymentMethods",
      "description": "Coleção de métodos de pagamento"
    },
    "/settings/global": {
      "schema": "settings",
      "description": "Documento único de configurações"
    }
  }
}
